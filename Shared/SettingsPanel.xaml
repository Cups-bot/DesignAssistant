<!--
    Настройки рабочего места — панель ВНУТРИ окна, а не отдельное окно.

    Раньше это было модальное окно 560×680. Прототип отвергает такой вариант
    прямо: второе окно в таскбаре и потеря контекста заказа. Плюс модальность
    была непроверяема — прогон на ней вис, и ради этого пришлось заводить
    подменный шов. Панель проверяется как обычная разметка, шов больше не нужен.

    Ширина фиксирована токеном Size.SettingsPanel: панель выезжает поверх сцены
    справа, габарит окна от неё не меняется.
-->
<UserControl x:Class="CupsCore.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{StaticResource Size.SettingsPanel}"
             Background="{StaticResource Surface}">

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── шапка ─── -->
            <Grid Grid.Row="0" Margin="14,12,10,8">
                <TextBlock Style="{StaticResource Title}" FontSize="13.5" Text="Настройки"
                           VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" Style="{StaticResource IconButton}"
                        Width="22" Height="22" HorizontalAlignment="Right"
                        ToolTip="Закрыть" Click="Cancel_Click">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource I.Close}"
                          Width="12" Height="12" Stretch="Uniform" StrokeThickness="3"/>
                </Button>
            </Grid>

            <!-- ─── содержимое ─── -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel Margin="14,0,4,24">

                        <!-- Режим -->
                        <TextBlock Style="{StaticResource Label}" Text="РАБОЧЕЕ МЕСТО" Margin="0,0,0,6"/>
                        <Border CornerRadius="{StaticResource R.Sm}" Padding="3" Margin="0,0,0,14"
                                Background="{StaticResource Input}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="OfficeRadio" Grid.Column="0" Style="{StaticResource Segment}"
                                             Content="Сетевой" GroupName="Mode" Checked="ModeChanged"
                                             ToolTip="Рабочие папки на сетевом диске"/>
                                <RadioButton x:Name="RemoteRadio" Grid.Column="1" Style="{StaticResource Segment}"
                                             Content="Локально" GroupName="Mode" Checked="ModeChanged"
                                             ToolTip="Своя структура папок на этой машине"/>
                            </Grid>
                        </Border>

                        <!-- Папка STAKANY -->
                        <TextBlock Style="{StaticResource Label}" Text="ПАПКА STAKANY" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BaseBox" Grid.Column="0" Style="{StaticResource Field}"
                                     Height="30" FontSize="{StaticResource T.Label}" Padding="9,0"/>
                            <Button Grid.Column="1" Style="{StaticResource Outline}" Margin="6,0,0,0"
                                    Content="Обзор" Click="BrowseBase_Click"/>
                        </Grid>
                        <Button Style="{StaticResource Outline}" Margin="0,6,0,14"
                                HorizontalAlignment="Stretch" Content="Разложить по офисной структуре"
                                ToolTip="Заполнить все папки ниже по образцу рабочей сети"
                                Click="ApplyBase_Click"/>

                        <!-- Папки направлений -->
                        <TextBlock Style="{StaticResource Label}" Text="ПАПКИ НАПРАВЛЕНИЙ" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="RootsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,3" Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Style="{StaticResource IconPlain}"
                                              Data="{Binding StatusIcon}" Stroke="{Binding StatusBrush}"
                                              Width="14" Height="14" Stretch="Uniform" StrokeThickness="2.6"
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Value}" FontSize="11.5"
                                                       Text="{Binding Title}" ToolTip="{Binding Title}"/>
                                            <TextBlock Style="{StaticResource Mono}" FontSize="9.5"
                                                       Foreground="#3E4A5C" Text="{Binding Path}"
                                                       ToolTip="{Binding Path}"/>
                                        </StackPanel>
                                        <!-- Кнопка по содержимому, а не во всю высоту строки:
                                             растянутая читалась как плитка и съедала
                                             ширину, из-за чего названия папок обрезались. -->
                                        <Button Grid.Column="2" Style="{StaticResource Outline}"
                                                VerticalAlignment="Center" Padding="7,3"
                                                Tag="{Binding}" Click="BrowseRoot_Click"
                                                ToolTip="Указать другую папку">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Folder}"
                                                  Width="13" Height="13" Stretch="Uniform" StrokeThickness="2.8"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource Outline}" Margin="0,0,3,0"
                                    Content="Проверить" Click="Check_Click"/>
                            <Button Grid.Column="1" Style="{StaticResource Outline}" Margin="3,0,0,0"
                                    Content="Создать папки" Click="CreateFolders_Click"/>
                        </Grid>

                        <!-- Illustrator -->
                        <TextBlock Style="{StaticResource Label}" Text="ILLUSTRATOR" Margin="0,0,0,6"/>
                        <ComboBox x:Name="IllustratorCombo" Style="{StaticResource Combo}" Height="30"/>
                        <Button Style="{StaticResource Outline}" Margin="0,6,0,0"
                                HorizontalAlignment="Stretch" Content="Указать файл…"
                                Click="BrowseIllustrator_Click"/>
                        <TextBlock x:Name="IllustratorHint" Style="{StaticResource Body}"
                                   FontSize="10.5" Margin="2,6,0,14"/>

                        <!-- Bitrix -->
                        <TextBlock Style="{StaticResource Label}" Text="ДОСТУП К BITRIX" Margin="0,0,0,6"/>
                        <TextBox x:Name="BitrixKeyBox" Style="{StaticResource Field}"
                                 FontSize="10.5" TextWrapping="Wrap" AcceptsReturn="False"
                                 Height="Auto" MinHeight="34" MaxHeight="60" Padding="9,7"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                        <Button x:Name="BitrixTestButton" Style="{StaticResource Outline}" Margin="0,6,0,0"
                                HorizontalAlignment="Stretch" Content="Проверить связь"
                                Click="BitrixTest_Click"/>
                        <TextBlock x:Name="BitrixHint" Style="{StaticResource Body}"
                                   FontSize="10.5" Margin="2,6,0,14"/>

                        <!-- Каталог -->
                        <TextBlock Style="{StaticResource Label}" Text="КАТАЛОГ ПРОДУКТОВ" Margin="0,0,0,6"/>
                        <TextBlock x:Name="CatalogInfo" Style="{StaticResource Value}" FontSize="11.5"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="CatalogSource" Style="{StaticResource Body}"
                                   FontSize="10.5" Margin="0,2,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource Outline}" Margin="0,0,3,0"
                                    Content="Проверить" ToolTip="Сверить описание продуктов и наличие шаблонов"
                                    Click="CheckCatalog_Click"/>
                            <Button Grid.Column="1" Style="{StaticResource Outline}" Margin="3,0,0,0"
                                    Content="Перечитать" Click="ReloadCatalog_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Rectangle Height="14" VerticalAlignment="Bottom" IsHitTestVisible="False"
                           Margin="0,0,10,0" Fill="{StaticResource FadeToSurface}"/>
            </Grid>

            <!-- ─── сообщение ─── -->
            <Border x:Name="MessagePanel" Grid.Row="2" Visibility="Collapsed"
                    Margin="14,0,14,8" CornerRadius="{StaticResource R.Sm}" Padding="10,7"
                    Background="#2A1B10" BorderBrush="#7C4A12" BorderThickness="1">
                <TextBlock x:Name="MessageText" Style="{StaticResource Body}"
                           Foreground="{StaticResource Warn}" FontSize="10.5"/>
            </Border>

            <!-- ─── действия ─── -->
            <Grid Grid.Row="3" Margin="14,0,14,12">
                <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0"
                        VerticalAlignment="Top" Margin="-14,0,-14,0"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton" Grid.Column="0" Style="{StaticResource Ghost}"
                            Content="Отмена" Click="Cancel_Click"/>
                    <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource PrimaryAction}"
                            Height="34" Margin="8,0,0,0" Content="Сохранить" Click="Save_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
