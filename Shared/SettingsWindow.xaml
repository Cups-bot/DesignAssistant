<Window x:Class="CupsCore.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки рабочего места"
        Width="560" Height="680"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#020617">

    <Window.Resources>
        <FontFamily x:Key="Reg">pack://application:,,,/Fonts/#SF Pro Text, Segoe UI</FontFamily>
        <FontFamily x:Key="Med">pack://application:,,,/Fonts/#SF Pro Text Medium, Segoe UI</FontFamily>
        <FontFamily x:Key="Semi">pack://application:,,,/Fonts/#SF Pro Text Semibold, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="TextMain" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource Med}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="2,0,0,7"/>
        </Style>

        <Style x:Key="Box" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#0C1426"/>
            <Setter Property="BorderBrush" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="{StaticResource Reg}"/>
            <Setter Property="CaretBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#1F2937"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontFamily" Value="{StaticResource Med}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1D283A"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="FontFamily" Value="{StaticResource Semi}"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#38BDF8" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="BorderBrush" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="НАСТРОЙКИ РАБОЧЕГО МЕСТА"
                   Foreground="{StaticResource TextMain}" FontFamily="{StaticResource Semi}"
                   FontSize="13" Margin="2,0,0,4"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>

                <!-- Режим и базовая папка -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ГДЕ ВЫ РАБОТАЕТЕ" Style="{StaticResource Caption}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="OfficeRadio" Content="В офисе (сетевой диск)"
                                         Foreground="{StaticResource TextMain}" FontFamily="{StaticResource Reg}"
                                         FontSize="12.5" Margin="0,0,18,0" Checked="ModeChanged"/>
                            <RadioButton x:Name="RemoteRadio" Content="На своей машине"
                                         Foreground="{StaticResource TextMain}" FontFamily="{StaticResource Reg}"
                                         FontSize="12.5" Checked="ModeChanged"/>
                        </StackPanel>

                        <TextBlock Text="ПАПКА STAKANY" Style="{StaticResource Caption}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BaseBox" Grid.Column="0" Style="{StaticResource Box}"/>
                            <Button Grid.Column="1" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                    Content="Обзор…" Click="BrowseBase_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                    Content="Разложить по офисной структуре"
                                    ToolTip="Заполнить все папки ниже по образцу рабочей сети"
                                    Click="ApplyBase_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Корни -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ПАПКИ" Style="{StaticResource Caption}"/>
                        <ItemsControl x:Name="RootsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMuted}"
                                                       FontFamily="{StaticResource Reg}" FontSize="11"
                                                       HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                                       FontFamily="{StaticResource Med}" FontSize="11"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource Box}"
                                                     Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                                    Content="Обзор…" Tag="{Binding}" Click="BrowseRoot_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Style="{StaticResource Ghost}" Content="Проверить"
                                    Click="Check_Click"/>
                            <Button Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                    Content="Создать недостающие папки" Click="CreateFolders_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Illustrator -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ILLUSTRATOR" Style="{StaticResource Caption}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="IllustratorCombo" Grid.Column="0" Height="34"
                                      FontFamily="{StaticResource Reg}" FontSize="12.5"/>
                            <Button Grid.Column="1" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                    Content="Указать файл…" Click="BrowseIllustrator_Click"/>
                        </Grid>
                        <TextBlock x:Name="IllustratorHint" Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource Reg}" FontSize="11"
                                   TextWrapping="Wrap" Margin="2,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Доступ к Bitrix -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ДОСТУП К BITRIX" Style="{StaticResource Caption}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Логин"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource Reg}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="BitrixLoginBox"
                                     Style="{StaticResource Box}" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Пароль"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource Reg}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="BitrixPasswordBox"
                                         Margin="0,3" Height="32" Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         Background="#0C1426" Foreground="{StaticResource TextMain}"
                                         BorderBrush="#1F2937" BorderThickness="1.2"
                                         FontFamily="{StaticResource Reg}" FontSize="12.5"/>
                        </Grid>

                        <TextBlock x:Name="BitrixHint" Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource Reg}" FontSize="11"
                                   TextWrapping="Wrap" Margin="2,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Каталог продуктов -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="КАТАЛОГ ПРОДУКТОВ" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="CatalogInfo" Foreground="{StaticResource TextMain}"
                                   FontFamily="{StaticResource Reg}" FontSize="12"
                                   TextWrapping="Wrap" Margin="2,0,0,4"/>
                        <TextBlock x:Name="CatalogSource" Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource Reg}" FontSize="11"
                                   TextWrapping="Wrap" Margin="2,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Ghost}" Content="Проверить каталог"
                                    ToolTip="Проверить описание продуктов и наличие файлов шаблонов"
                                    Click="CheckCatalog_Click"/>
                            <Button Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                    Content="Перечитать" Click="ReloadCatalog_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Сообщения -->
        <Border Grid.Row="2" x:Name="MessagePanel" Visibility="Collapsed" Margin="0,4,0,0"
                CornerRadius="10" Padding="12,8" Background="#2A1B10"
                BorderBrush="#7C4A12" BorderThickness="1">
            <TextBlock x:Name="MessageText" Foreground="#FBBF24" FontFamily="{StaticResource Reg}"
                       FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource Ghost}" Content="Отмена" Click="Cancel_Click"/>
            <Button Style="{StaticResource Primary}" Margin="8,0,0,0" Content="Сохранить" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
