<!--
    Язычок свёрнутой программы: узкая полоска у правого края ЭКРАНА,
    поверх всех окон.

    Это отдельное окно, а не элемент главного: главное окно в свёрнутом виде
    спрятано целиком, и рисовать язычок ему нечем.

    AllowsTransparency здесь допустима, в отличие от главного окна: она отключает
    субпиксельное сглаживание, но текста тут нет — только стрелка, а скруглённый
    левый край без прозрачности не сделать.
-->
<Window x:Class="CupsForge.DockTab"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CupsForge"
        Width="18" Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False">

    <Border x:Name="Tab" CornerRadius="9,0,0,9"
            Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,1"
            Cursor="Hand"
            ToolTip="CupsForge — нажмите, чтобы развернуть. Правой кнопкой — выйти."
            MouseLeftButtonUp="Tab_Click"
            MouseRightButtonUp="Tab_Exit">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Path x:Name="Arrow" Style="{StaticResource IconPlain}"
              Data="{StaticResource I.ChevronLeft}" Stroke="{StaticResource Muted}"
              Width="12" Height="12" Stretch="Uniform" StrokeThickness="2.8"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</Window>
