{
  // Образец. Рабочий файл называется appsettings.json, лежит рядом с CupsForge.exe
  // и в репозиторий не попадает — там учётные данные к API, открытому в интернет.
  //
  // Обычно доступ настраивается в самой программе: шестерёнка → ДОСТУП К BITRIX.
  // Этот файл нужен только как запасной путь для уже настроенных машин.
  // AuthorizationHeader — готовый ключ; можно как есть, можно с приставкой "Basic".
  "Bitrix": {
    "BaseUrl": "https://bitrix.formacia.ru",
    "GetDataPath": "/mycups/api/design/getData",

    "AuthorizationHeader": "",
    "Login": "",
    "Password": "",

    "TimeoutSeconds": 30
  }
}
