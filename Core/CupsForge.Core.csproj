<Project Sdk="Microsoft.NET.Sdk">

  <!--
      Ядро: предметная область и работа с диском. Каталог продуктов, логические
      корни, подбор шаблона, создание проекта, профиль машины, обновления.

      ЗДЕСЬ НЕТ WPF — и это главное, ради чего ядро выделено в отдельный проект.
      Раньше «ядро не знает про окна» держалось на договорённости: код лежал
      в папке, которую приложение втягивало в свою сборку, и ничто не мешало
      написать в нём using System.Windows. Договорённость успела нарушиться
      в четырёх файлах, и никто этого не заметил.

      Теперь это проверяет компилятор: UseWPF здесь нет, ссылки на
      PresentationFramework нет, и попытка тронуть окно из ядра не соберётся.

      Цель — net8.0-WINDOWS, но БЕЗ UseWPF. Разница принципиальная:
      «-windows» говорит, что ядро работает с реестром (там ищется Illustrator),
      с буквами дисков и с профилем пользователя Windows — это правда, и без
      пометки компилятор справедливо ругался на каждое обращение к реестру.
      А отсутствие UseWPF означает, что окон здесь нет и не будет.

      Сначала стояло просто net8.0 — с комментарием, что ядро не зависит
      от Windows. Это было неправдой, и десять предупреждений об этом честно
      сообщали.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CupsCore</RootNamespace>
    <AssemblyName>CupsForge.Core</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Каталог продуктов: копия внутри программы — последний источник
         в цепочке, чтобы программа работала даже без папки шаблонов. -->
    <EmbeddedResource Include="catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Обновление программы. Живёт в ядре, потому что не касается окон:
         решает, есть ли новая версия и откуда её взять. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
