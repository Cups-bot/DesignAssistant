<!--
    Иконки — один штриховой набор в стиле Lucide (MIT), 24×24, толщина 1.7.

    Почему геометрия, а не шрифт и не картинки:
      - эмодзи (⚙ ✎ 📄, как было раньше) рисуются шрифтом системы и выглядят
        по-разному на разных машинах, а на части — цветными;
      - PNG нужен в трёх плотностях и не красится под цвет текста.
    Path красится Stroke и масштабируется без потерь.

    Один стиль штриха на весь набор: скруглённые концы и стыки. Разнобой здесь
    заметен сразу — набор перестаёт читаться как набор.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Базовый штрих. Цвет наследуется от текста рядом: иконка — часть строки,
         а не отдельная сущность со своим цветом. -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="{StaticResource Size.Stroke}"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Width" Value="{StaticResource Size.Icon}"/>
        <Setter Property="Height" Value="{StaticResource Size.Icon}"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Тот же штрих, но цвет задаётся явно: для иконок вне кнопок. -->
    <Style x:Key="IconPlain" TargetType="Path">
        <Setter Property="StrokeThickness" Value="{StaticResource Size.Stroke}"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Width" Value="{StaticResource Size.Icon}"/>
        <Setter Property="Height" Value="{StaticResource Size.Icon}"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ============ ГЕОМЕТРИЯ ============ -->
    <!-- Координаты в поле 24×24, как в исходном наборе. Меняя размер, меняйте
         Width/Height и добавляйте Stretch="Uniform" — но помните, что при
         Uniform масштабируется и штрих. -->

    <!-- Звено цепи: ссылка на заказ. -->
    <Geometry x:Key="I.Link">M9,17 H7 A5,5 0 0 1 7,7 h2 M15,7 h2 a5,5 0 1 1 0,10 h-2 M8,12 h8</Geometry>

    <!-- Стрелка вправо: «загрузить», «следующий заказ». -->
    <Geometry x:Key="I.Arrow">M5,12 h13 M12,5 l7,7 -7,7</Geometry>

    <!-- Карандаш: ручной ввод и точечная правка поля. -->
    <Geometry x:Key="I.Pencil">M12,20 h9 M16.5,3.5 a2.12,2.12 0 0 1 3,3 L7,19 l-4,1 1,-4 Z</Geometry>

    <!-- Ползунки: настройки. Шестерёнка в 16 px превращается в кашу. -->
    <Geometry x:Key="I.Sliders">M4,6 h5 M13,6 h7 M4,12 h11 M19,12 h1 M4,18 h3 M11,18 h9
        M9,6 A2,2 0 1 1 13,6 A2,2 0 1 1 9,6 M15,12 A2,2 0 1 1 19,12 A2,2 0 1 1 15,12
        M7,18 A2,2 0 1 1 11,18 A2,2 0 1 1 7,18</Geometry>

    <!-- Галка: готово. -->
    <Geometry x:Key="I.Check">M5,12.5 l5,5 L19,7</Geometry>

    <!-- Галка в круге: пункт списка выполнен. -->
    <Geometry x:Key="I.CheckCircle">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12
        M8.5,12.2 l2.5,2.5 4.8,-5</Geometry>

    <!-- Треугольник с восклицанием: требует внимания, но не провал. -->
    <Geometry x:Key="I.Warn">M10.29,3.86 L1.82,18 A2,2 0 0 0 3.53,21 h16.94 a2,2 0 0 0 1.71,-3
        L13.71,3.86 a2,2 0 0 0 -3.42,0 Z M12,9 v4 M12,17 h0.01</Geometry>

    <Geometry x:Key="I.ChevronDown">M6,9 l6,6 6,-6</Geometry>
    <Geometry x:Key="I.ChevronUp">M18,15 l-6,-6 -6,6</Geometry>
    <Geometry x:Key="I.ChevronRight">M9,6 l6,6 -6,6</Geometry>

    <!-- Папка: готовый проект. -->
    <Geometry x:Key="I.Folder">M20,20 a2,2 0 0 0 2,-2 V9 a2,2 0 0 0 -2,-2 h-7.9
        a2,2 0 0 1 -1.69,-0.9 L9.6,4.9 A2,2 0 0 0 7.93,4 H4 a2,2 0 0 0 -2,2 v12
        a2,2 0 0 0 2,2 Z</Geometry>

    <!-- Папка с плюсом: создать проект. Главное действие программы. -->
    <Geometry x:Key="I.FolderPlus">M20,20 a2,2 0 0 0 2,-2 V9 a2,2 0 0 0 -2,-2 h-7.9
        a2,2 0 0 1 -1.69,-0.9 L9.6,4.9 A2,2 0 0 0 7.93,4 H4 a2,2 0 0 0 -2,2 v12
        a2,2 0 0 0 2,2 Z M12,11 v6 M9,14 h6</Geometry>

    <!-- Круговые стрелки: перечитать каталог. -->
    <Geometry x:Key="I.Refresh">M3,12 a9,9 0 0 1 9,-9 9.75,9.75 0 0 1 6.74,2.74 L21,8
        M21,3 v5 h-5 M21,12 a9,9 0 0 1 -9,9 9.75,9.75 0 0 1 -6.74,-2.74 L3,16
        M8,16 H3 v5</Geometry>

    <!-- Крест: закрыть шторку, панель, лист. -->
    <Geometry x:Key="I.Close">M18,6 L6,18 M6,6 L18,18</Geometry>

    <!-- Лист бумаги: журнал. -->
    <Geometry x:Key="I.Doc">M15,3 H6 a2,2 0 0 0 -2,2 v14 a2,2 0 0 0 2,2 h12
        a2,2 0 0 0 2,-2 V8 Z M14,3 v5 h5 M8,13 h8 M8,17 h5</Geometry>

    <!-- Стрелка вниз к черте: обновление. -->
    <Geometry x:Key="I.Download">M12,3 v12 M7,11 l5,5 5,-5 M4,20 h16</Geometry>

    <!-- Кисть: Illustrator, выбор материала. -->
    <Geometry x:Key="I.Brush">M4,20 c2.5,0 4,-1.5 4,-4 M8,16 L18.5,5.5
        a2.1,2.1 0 0 1 3,3 L11,19</Geometry>

    <!-- Планшет с зажимом: буфер обмена. -->
    <Geometry x:Key="I.Clipboard">M9,3 h6 a1,1 0 0 1 1,1 v2 a1,1 0 0 1 -1,1 h-6
        a1,1 0 0 1 -1,-1 V4 a1,1 0 0 1 1,-1 Z M16,5 h2 a2,2 0 0 1 2,2 v12
        a2,2 0 0 1 -2,2 H6 a2,2 0 0 1 -2,-2 V7 a2,2 0 0 1 2,-2 h2</Geometry>

    <!-- Диск: рабочие папки, сетевой диск. -->
    <Geometry x:Key="I.Disk">M22,12 H2 M5.45,5.11 L2,12 v6 a2,2 0 0 0 2,2 h16
        a2,2 0 0 0 2,-2 v-6 l-3.45,-6.89 A2,2 0 0 0 16.76,4 H7.24
        a2,2 0 0 0 -1.79,1.11 Z M6,16 h0.01 M10,16 h0.01</Geometry>

</ResourceDictionary>
