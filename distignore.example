# Что НЕ уезжает в раздачу.
#
# По строке на образец. Путь пишется от корня папки шаблонов, через косую черту.
# Строка без звёздочек, совпавшая с началом пути, означает папку целиком.
# Мусор Windows (Thumbs.db, desktop.ini, *.tmp) отсекается и без этого файла.
#
# Проверить, что получится, ничего не заливая:
#     .\push-templates.cmd -WhatIf
#
# ВАЖНО: этот файл в раздачу не уезжает — он про раздачу, а не в ней.
# Копия лежит в репозитории программы. Правите здесь — обновите и там.

# --- Не для чужих глаз ---------------------------------------------------
# Раздача ПУБЛИЧНАЯ: любой человек по прямой ссылке скачает что угодно.
# Шаблоны не секретны — они и так уходят клиентам. А это — нет:
# recipes.csv — процентный состав каждой краски, prices.csv — закупочные цены,
# anilox/areas/widths — параметры оборудования. Это наработки отдела.
Scripts/SEP

# --- Архивы и черновики --------------------------------------------------
# Лежат рядом с рабочим по-хозяйски, но дизайнеру на удалёнке не нужны,
# а место и время заливки занимают.
9_Sugar/Arhive
Scripts/_Архив
3_CupsToYou_Tr/OLD
5_CupsToYou_En/Не готово
11_Bag/под вопросом

# --- Служебное -----------------------------------------------------------
# Метаданные Adobe Bridge: скрытые файлы рядом с картинками.
Kraft/.metadata
.metadata

# --- Тяжёлое и ненужное --------------------------------------------------
# Папка All на рабочем диске весит около 306 МБ, и программе не нужна вовсе.
# На домашней копии её нет — правило висит для прогона в офисе.
All
