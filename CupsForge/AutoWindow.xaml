<Window x:Class="CupsForge.AutoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CupsForge"
        Width="{StaticResource Size.Window}"
        Height="{StaticResource Size.WindowHeight}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Images/Icon/logo.ico">

    <!--
        Габарит окна КОНСТАНТЕН во всех состояниях.

        Раньше стояло SizeToContent="Height", и окно росло вниз от каждой
        появившейся панели, а обработчик SizeChanged двигал Top, чтобы нижний
        край стоял на месте. Кнопка «Создать проект» при этом уезжала: на глаз
        она то там, то тут, и мышечная память не работала.

        Теперь всё, что раньше растило окно, кладётся ПОВЕРХ сцены: журнал —
        шторкой снизу, настройки — панелью справа, правка — листом на одно поле.
        Размер задаётся токенами Size.Window / Size.WindowHeight — уменьшить
        окно значит поменять два числа, а не переверстать.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{StaticResource Size.Titlebar}"
                            ResizeBorderThickness="0" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <!-- Сцена и подвал; уведомления вклиниваются строкой между шапкой и сценой -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ ШАПКА ═══════════ -->
            <Grid Grid.Row="0" Height="{StaticResource Size.Titlebar}">
                <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Margin="14,0,0,0">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource Danger}" Margin="0,0,6,0" Cursor="Hand"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             MouseLeftButtonDown="Close_Click" ToolTip="Закрыть"/>
                    <Ellipse Width="10" Height="10" Fill="{StaticResource Warn}" Margin="0,0,6,0" Cursor="Hand"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             MouseLeftButtonDown="Minimize_Click" ToolTip="Свернуть"/>
                    <Ellipse Width="10" Height="10" Fill="{StaticResource Ok}"/>
                </StackPanel>

                <!-- Названия в шапке нет: программа одна, окно одно, и подпись
                     «CupsForge» сообщала пользователю ровно ноль. Шапка нужна
                     под управление окном и настройки, а не под самоназвание. -->

                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right" Margin="0,0,10,0" ToolTip="Настройки рабочего места"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="SettingsButton_Click">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource I.Sliders}"
                          Width="16" Height="16" Stretch="Uniform" StrokeThickness="2.4"/>
                </Button>
            </Grid>

            <!-- ═══════════ УВЕДОМЛЕНИЕ ═══════════ -->
            <!--
                Одна полоска на все сообщения, показывающая ОДНО за раз.
                Раньше их было четыре (обновление, шаблоны, каталог, ненастроенные
                папки), и все сидели в одной строке сетки друг поверх друга:
                два сообщения сразу — и второе не видно вовсе.
                Что показывать, решает очередь в коде, а не разметка.
            -->
            <Border x:Name="NoticeBar" Grid.Row="1" Visibility="Collapsed"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource LineSoft}"
                    BorderThickness="0,0,0,1" Padding="12,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Path x:Name="NoticeIcon" Grid.Column="0" Style="{StaticResource IconPlain}"
                          Data="{StaticResource I.Download}" Stroke="{StaticResource Accent}"
                          Width="14" Height="14" Stretch="Uniform" StrokeThickness="2.6"
                          VerticalAlignment="Center" Margin="0,0,9,0"/>

                    <TextBlock x:Name="NoticeText" Grid.Column="1" Style="{StaticResource Body}"
                               Foreground="{StaticResource Text}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <Button x:Name="NoticeAction" Grid.Column="2" Style="{StaticResource LinkAction}"
                            Visibility="Collapsed" Click="NoticeAction_Click"/>

                    <Button x:Name="NoticeClose" Grid.Column="3" Style="{StaticResource IconButton}"
                            Width="20" Height="20" Margin="4,0,0,0" ToolTip="Скрыть"
                            Click="NoticeClose_Click">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Close}"
                              Width="11" Height="11" Stretch="Uniform" StrokeThickness="3"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════ СЦЕНА ═══════════ -->
            <!-- Состояния лежат друг на друге, видно ровно одно. -->
            <Grid Grid.Row="2" Margin="{StaticResource StagePadding}">

                <!-- ─── ПУСТО ─── -->
                <Grid x:Name="StateEmpty">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Width="52" Height="52" HorizontalAlignment="Center">
                            <Ellipse Fill="#12000000"/>
                            <Ellipse Fill="#1238BDF8" Stroke="#3838BDF8" StrokeThickness="1"/>
                            <Path Style="{StaticResource IconPlain}" Data="{StaticResource I.Link}"
                                  Stroke="{StaticResource Accent}" HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Title}" Text="Вставьте ссылку на заказ"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LinkBox" Grid.Column="0" Style="{StaticResource Field}"
                                     KeyDown="LinkBox_KeyDown" TextChanged="LinkBox_TextChanged"/>
                            <Button x:Name="FetchButton" Grid.Column="1" Style="{StaticResource SubmitButton}"
                                    Margin="8,0,0,0" ToolTip="Загрузить данные из Bitrix"
                                    Click="FetchButton_Click">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Arrow}"
                                      Width="18" Height="18" Stretch="Uniform" StrokeThickness="2.4"/>
                            </Button>
                        </Grid>

                        <Button x:Name="PencilButton" Style="{StaticResource Ghost}"
                                HorizontalAlignment="Center" Margin="0,12,0,0"
                                ToolTip="Ввести данные заказа руками" Click="PencilButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Pencil}"
                                      Width="14" Height="14" Stretch="Uniform" StrokeThickness="2.8"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="Ввести вручную" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Ссылка уже в буфере — предлагаем взять, а не заставляем вставлять. -->
                        <Border x:Name="ClipboardHint" Visibility="Collapsed" Margin="0,16,0,0"
                                CornerRadius="{StaticResource R.Md}" Padding="10,8"
                                Background="{StaticResource Input}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Style="{StaticResource IconPlain}"
                                      Data="{StaticResource I.Clipboard}" Stroke="{StaticResource Dim}"
                                      Width="14" Height="14" Stretch="Uniform" StrokeThickness="2.6"
                                      VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock x:Name="ClipboardText" Grid.Column="1" Style="{StaticResource Mono}"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Button x:Name="ClipboardTake" Grid.Column="2" Style="{StaticResource LinkAction}"
                                        Content="Взять" Click="ClipboardTake_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ─── ПРОВЕРКА ─── -->
                <Grid x:Name="StateChecking" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <Ellipse x:Name="Spinner" Width="46" Height="46" HorizontalAlignment="Center"
                                 Stroke="{StaticResource AccentDeep}" StrokeThickness="3"
                                 StrokeDashArray="3 1.2" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Style="{StaticResource Title}" Text="Проверяем заказ"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock x:Name="CheckingLink" Style="{StaticResource Mono}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0" MaxWidth="300"/>
                    </StackPanel>
                </Grid>

                <!-- ─── РЕЗУЛЬТАТ (готово / ошибка) ─── -->
                <Grid x:Name="StateResult" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Шапка результата -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ResultBadge" Grid.Column="0" Width="34" Height="34"
                                CornerRadius="{StaticResource R.Sm}" Margin="0,0,11,0"
                                Background="#1A34D399" BorderBrush="#4834D399" BorderThickness="1">
                            <Path x:Name="ResultBadgeIcon" Style="{StaticResource IconPlain}"
                                  Data="{StaticResource I.Check}" Stroke="{StaticResource Ok}"
                                  Width="19" Height="19" Stretch="Uniform" StrokeThickness="2.4"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ResultHeadline" Style="{StaticResource Title}" FontSize="14.5"/>
                            <TextBlock x:Name="ResultSubline" Style="{StaticResource Mono}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Поля заказа. Список — ДАННЫЕ: состав строится из заказа
                         и каталога, а не перечисляется здесь. Новый продукт со
                         своим полем появится сам. -->
                    <Border Grid.Row="1" Margin="0,14,0,12" CornerRadius="{StaticResource R.Md}"
                            Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" ClipToBounds="True">
                        <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                            <ItemsControl x:Name="ResultFields">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Ghost}" Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Tag="{Binding}" Click="ResultField_Click"
                                                ToolTip="{Binding Hint}">
                                            <Border Background="Transparent" Padding="12,8"
                                                    BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource Body}"
                                                               Foreground="{StaticResource Dim}"
                                                               Text="{Binding Label}" TextWrapping="NoWrap"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource Value}"
                                                               Text="{Binding Value}"
                                                               Foreground="{Binding ValueBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <Path Grid.Column="2" Style="{StaticResource IconPlain}"
                                                          Data="{StaticResource I.Pencil}" Stroke="#2A3546"
                                                          Width="13" Height="13" Stretch="Uniform"
                                                          StrokeThickness="2.8" VerticalAlignment="Center"
                                                          Visibility="{Binding FixVisibility}"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                            <Rectangle Height="16" VerticalAlignment="Bottom" IsHitTestVisible="False" Margin="0,0,10,0"
                                       Fill="{StaticResource FadeToPanel}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <Button x:Name="BuildButton" Style="{StaticResource PrimaryAction}"
                                IsEnabled="False" Click="BuildButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.FolderPlus}"
                                      Width="17" Height="17" Stretch="Uniform" StrokeThickness="2.4"
                                      Margin="0,0,9,0"/>
                                <TextBlock x:Name="BuildButtonText" Text="Создать проект" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Выход из разобранного заказа. Мелким текстом и без
                             заливки: отказ — не равноправная альтернатива созданию,
                             а запасной выход. Акцент на экране остаётся один. -->
                        <Button x:Name="CancelResultButton" Style="{StaticResource Ghost}"
                                Margin="0,6,0,0" HorizontalAlignment="Center"
                                FontSize="{StaticResource T.Label}" Content="Отменить"
                                Click="CancelResult_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ─── СОЗДАЁТСЯ ─── -->
                <Grid x:Name="StateRunning" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="52" Height="52" HorizontalAlignment="Center"
                                CornerRadius="{StaticResource R.Sm}"
                                Background="#1238BDF8" BorderBrush="#3838BDF8" BorderThickness="1">
                            <Path Style="{StaticResource IconPlain}" Data="{StaticResource I.FolderPlus}"
                                  Stroke="{StaticResource Accent}"/>
                        </Border>
                        <TextBlock x:Name="RunningLabel" Style="{StaticResource Title}"
                                   Text="Создаём проект" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <Border Height="3" Margin="0,16,0,0" CornerRadius="2"
                                Background="{StaticResource Line}" ClipToBounds="True">
                            <Border x:Name="RunningBar" Width="120" HorizontalAlignment="Left"
                                    CornerRadius="2" Background="{StaticResource AccentGradient}"
                                    RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="RunningBarShift"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock x:Name="RunningPath" Style="{StaticResource Mono}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" MaxWidth="320"/>
                    </StackPanel>
                </Grid>

                <!-- ─── СОЗДАН ─── -->
                <Grid x:Name="StateDone" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <Grid Width="52" Height="52" HorizontalAlignment="Center">
                            <Ellipse Fill="#1A34D399" Stroke="#5234D399" StrokeThickness="1"/>
                            <Path Style="{StaticResource IconPlain}" Data="{StaticResource I.Check}"
                                  Stroke="{StaticResource Ok}" Width="26" Height="26" Stretch="Uniform"
                                  StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="DoneHeadline" Style="{StaticResource Title}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center"/>
                        <TextBlock x:Name="DonePath" Style="{StaticResource Mono}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" MaxWidth="320"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="NextOrderButton" Style="{StaticResource PrimaryAction}"
                                Click="NextOrder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Arrow}"
                                      Width="17" Height="17" Stretch="Uniform" StrokeThickness="2.4"
                                      Margin="0,0,9,0"/>
                                <TextBlock Text="Следующий заказ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenFolderButton" Style="{StaticResource Ghost}"
                                HorizontalAlignment="Center" Margin="0,8,0,0"
                                Content="Открыть папку" Click="OpenFolder_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ─── РУЧНОЙ ВВОД ─── -->
                <!-- Состав полей берётся из каталога: новый продукт появляется
                     в списках сам, рисовать для него строку не требуется. -->
                <Grid x:Name="StateManual" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource Label}" Text="РУЧНОЙ ВВОД" VerticalAlignment="Center"/>
                        <Button x:Name="ManualCloseButton" Style="{StaticResource IconButton}"
                                Width="22" Height="22" HorizontalAlignment="Right" ToolTip="Вернуться к ссылке"
                                Click="ManualClose_Click">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Close}"
                                  Width="12" Height="12" Stretch="Uniform" StrokeThickness="3"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <Border x:Name="ManualPanel" Background="Transparent">
                            <StackPanel>
                                <!-- Без подписи поле читается как «поиск»: дизайнер
                                     не догадается, что сюда идёт имя дизайна. -->
                                <TextBlock Style="{StaticResource Label}" Text="ИМЯ ДИЗАЙНА"
                                           Margin="2,0,0,5"/>
                                <TextBox x:Name="ManualNameBox" Style="{StaticResource Field}"
                                         Height="32" Margin="0,0,0,8"
                                         TextChanged="ManualName_Changed"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="LblBrand" Grid.Row="0" Grid.Column="0" Text="Направление"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BrandCombo" Grid.Row="0" Grid.Column="1" Margin="0,1.5" Height="26"
                                              Style="{StaticResource Combo}" SelectionChanged="ManualBrand_Changed"/>

                                    <TextBlock x:Name="LblType" Grid.Row="1" Grid.Column="0" Text="Тип продукта"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="TypeCombo" Grid.Row="1" Grid.Column="1" Margin="0,1.5" Height="26"
                                              Style="{StaticResource Combo}" SelectionChanged="ManualType_Changed"/>

                                    <TextBlock x:Name="LblTech" Grid.Row="2" Grid.Column="0" Text="Печать"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="TechCombo" Grid.Row="2" Grid.Column="1" Margin="0,1.5" Height="26"
                                              Style="{StaticResource Combo}" SelectionChanged="ManualDetail_Changed"/>

                                    <TextBlock x:Name="LblVariant" Grid.Row="3" Grid.Column="0" Text="Вариант"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VariantCombo" Grid.Row="3" Grid.Column="1" Margin="0,1.5" Height="26"
                                              Style="{StaticResource Combo}"/>

                                    <TextBlock x:Name="LblCountry" Grid.Row="4" Grid.Column="0" Text="Страна"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CountryCombo" Grid.Row="4" Grid.Column="1" Margin="0,1.5" Height="26"
                                              Style="{StaticResource Combo}"/>

                                    <TextBlock x:Name="LblMaterial" Grid.Row="5" Grid.Column="0" Text="Материал"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="MaterialCombo" Grid.Row="5" Grid.Column="1" Margin="0,1.5" Height="26"
                                              Style="{StaticResource Combo}" SelectionChanged="ManualDetail_Changed"/>

                                    <TextBlock x:Name="LblCoating" Grid.Row="6" Grid.Column="0" Text="Покрытие"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CoatingCombo" Grid.Row="6" Grid.Column="1" Margin="0,1.5" Height="26"
                                              Style="{StaticResource Combo}"/>
                                </Grid>

                                <TextBlock x:Name="ManualProductInfo" Style="{StaticResource Body}"
                                           Margin="2,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                        <!-- Накладка затухания: под ползунком, поверх содержимого. -->
                        <Rectangle Height="18" VerticalAlignment="Bottom" IsHitTestVisible="False" Margin="0,0,10,0"
                                   Fill="{StaticResource FadeToBg}"/>
                    </Grid>

                    <Button x:Name="ManualBuildButton" Grid.Row="2" Style="{StaticResource PrimaryAction}"
                            IsEnabled="False" Click="BuildButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.FolderPlus}"
                                  Width="17" Height="17" Stretch="Uniform" StrokeThickness="2.4"
                                  Margin="0,0,9,0"/>
                            <TextBlock Text="Создать проект" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- ═══════════ ПОДВАЛ ═══════════ -->
            <Button x:Name="JournalToggle" Grid.Row="3" Style="{StaticResource Ghost}"
                    Height="{StaticResource Size.Footer}" Padding="14,0"
                    HorizontalContentAlignment="Stretch" Click="JournalToggle_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource I.ChevronUp}"
                          Width="13" Height="13" Stretch="Uniform" StrokeThickness="2.8"
                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="Журнал"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="FooterHint" Grid.Column="2" Style="{StaticResource Mono}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- ═══════════ ЛИСТ ПРАВКИ ОДНОГО ПОЛЯ ═══════════ -->
            <!--
                Разбор ошибся в одном поле из семи. Открывать ради этого ручной
                ввод целиком значит заставить перезаполнить шесть верных: лист
                правит ровно то поле, по которому щёлкнули, и возвращает в тот же
                результат. Список вариантов — ДАННЫЕ из каталога.
            -->
            <Grid x:Name="FixOverlay" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="15">
                <Rectangle Fill="{StaticResource Scrim}" MouseLeftButtonDown="FixScrim_Click"/>
                <Border x:Name="FixSheet" VerticalAlignment="Bottom"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,1,0,0" CornerRadius="14,14,0,0" Padding="14,10,14,14">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="FixShift"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock x:Name="FixTitle" Style="{StaticResource Value}"
                                       FontSize="13" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                    HorizontalAlignment="Right" Click="FixClose_Click" ToolTip="Закрыть">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Close}"
                                      Width="12" Height="12" Stretch="Uniform" StrokeThickness="3"/>
                            </Button>
                        </Grid>

                        <!-- Выбор из списка -->
                        <Grid Grid.Row="1" x:Name="FixList">
                            <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto"
                                          Padding="0,0,10,0">
                                <ItemsControl x:Name="FixOptions">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Outline}" Margin="0,0,0,5"
                                                    Padding="11,9" HorizontalContentAlignment="Stretch"
                                                    Tag="{Binding}" Click="FixOption_Click">
                                                <Grid>
                                                    <TextBlock Style="{StaticResource Value}"
                                                               Text="{Binding Label}" HorizontalAlignment="Left"/>
                                                    <TextBlock Style="{StaticResource Mono}"
                                                               Text="{Binding Code}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Rectangle Height="14" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                       Margin="0,0,10,0" Fill="{StaticResource FadeToSurface}"/>
                        </Grid>

                        <!-- Ввод текстом: артикул списком не выбрать -->
                        <Grid Grid.Row="2" x:Name="FixText" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FixTextBox" Grid.Column="0" Style="{StaticResource Field}"
                                     Height="36" KeyDown="FixTextBox_KeyDown"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryAction}" Height="36"
                                    Margin="8,0,0,0" Padding="16,0" Content="Готово"
                                    Click="FixTextApply_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════ ПАНЕЛЬ НАСТРОЕК ═══════════ -->
            <!-- Выезжает справа ВНУТРИ окна. Отдельным окном было хуже: второе
                 окно в таскбаре и потеря контекста заказа. Модальность заодно
                 была непроверяема — прогон на ней вис. -->
            <Grid x:Name="SettingsOverlay" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="20">
                <Rectangle Fill="{StaticResource Scrim}" MouseLeftButtonDown="SettingsScrim_Click"/>
                <ContentControl x:Name="SettingsHost" HorizontalAlignment="Right"
                                RenderTransformOrigin="1,0.5">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="SettingsShift"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>

            <!-- ═══════════ ШТОРКА ЖУРНАЛА ═══════════ -->
            <!-- Поверх всего: окно от журнала не растёт. Раньше он разворачивал
                 окно вниз, и положение кнопок уезжало на 90 пикселей. -->
            <Grid x:Name="JournalOverlay" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="10">
                <Rectangle Fill="{StaticResource Scrim}" MouseLeftButtonDown="JournalScrim_Click"/>
                <Border x:Name="JournalSheet" VerticalAlignment="Bottom"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,1,0,0" CornerRadius="14,14,0,0"
                        RenderTransformOrigin="0.5,1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="JournalShift"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,10,10,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPlain}" Data="{StaticResource I.Doc}"
                                      Stroke="{StaticResource Dim}" Width="14" Height="14"
                                      Stretch="Uniform" StrokeThickness="2.6" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource Value}" Text="Журнал" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                    HorizontalAlignment="Right" Click="JournalToggle_Click" ToolTip="Закрыть">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource I.Close}"
                                      Width="12" Height="12" Stretch="Uniform" StrokeThickness="3"/>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="14,0,10,10">
                        <ScrollViewer x:Name="JournalScroll" MaxHeight="180"
                                      VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                            <ItemsControl x:Name="LogBox">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Style="{StaticResource IconPlain}"
                                                  Data="{Binding Icon}" Stroke="{Binding IconBrush}"
                                                  Width="13" Height="13" Stretch="Uniform" StrokeThickness="2.6"
                                                  VerticalAlignment="Top" Margin="0,2,8,0"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Mono}"
                                                       Foreground="#3E4A5C" Text="{Binding Time}"
                                                       VerticalAlignment="Top" Margin="0,1,8,0"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Body}"
                                                       Text="{Binding Text}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                            <Rectangle Height="16" VerticalAlignment="Bottom" IsHitTestVisible="False" Margin="0,0,10,0"
                                       Fill="{StaticResource FadeToSurface}"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="14,0,10,9">
                            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0"
                                    VerticalAlignment="Top" Margin="0,0,0,0"/>
                            <TextBlock x:Name="CatalogStamp" Style="{StaticResource Mono}"
                                       Foreground="#3E4A5C" VerticalAlignment="Center" Margin="0,9,0,0"/>
                            <Button x:Name="ReloadCatalogButton" Style="{StaticResource LinkAction}"
                                    HorizontalAlignment="Right" Margin="0,9,0,0"
                                    Click="ReloadCatalog_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource I.Refresh}"
                                          Width="15" Height="15" Stretch="Uniform" StrokeThickness="2.3"
                                          Margin="0,0,6,0"/>
                                    <TextBlock Text="Перечитать" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
