<!--
    Контролы, собранные из токенов. Ни одного значения по месту — только ссылки
    на Tokens.xaml. Если здесь появился литерал, значит в токенах чего-то не
    хватает; добавлять надо туда, а не сюда.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============ ПОЛЕ ВВОДА ============ -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource Size.Field}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Input}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDeep}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Regular}"/>
        <Setter Property="FontSize" Value="{StaticResource T.Value}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" CornerRadius="{StaticResource R.Md}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentDeep}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ГЛАВНОЕ ДЕЙСТВИЕ ============ -->
    <!-- Единственное место, где используется градиент. Один на экран: как только
         им покрашено что-то ещё, следующий шаг перестаёт читаться с одного взгляда. -->
    <Style x:Key="PrimaryAction" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Size.Action}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#F8FAFC"/>
        <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Semibold}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="{StaticResource R.Md}"
                            Background="{TemplateBinding Background}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="glow" BlurRadius="20" ShadowDepth="6"
                                              Direction="270" Opacity="0.34" Color="{StaticResource C.AccentDeep}"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.93"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.38"/>
                            <Setter TargetName="b" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ИКОНОЧНАЯ КНОПКА ============ -->
    <!-- Мелкая, без фона: настройки в шапке, крестик на шторке. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="{StaticResource R.Sm}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Input}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Квадратная кнопка отправки рядом с полем: градиент, размер поля. -->
    <Style x:Key="SubmitButton" TargetType="Button" BasedOn="{StaticResource PrimaryAction}">
        <Setter Property="Width" Value="{StaticResource Size.Field}"/>
        <Setter Property="Height" Value="{StaticResource Size.Field}"/>
    </Style>

    <!-- ============ ВТОРИЧНОЕ ДЕЙСТВИЕ ============ -->
    <!--
        Текст и иконка, без заливки. Всё, что не «следующий шаг», выглядит так.

        Радиус — R.Sm, а НЕ R.Pill. Пилюля хороша для короткой надписи, но у
        широкой кнопки WPF скругляет по половине высоты, и подсветка растягивалась
        в стадион во всю ширину: у подвала «Журнал» это выглядело так, будто
        нажали на половину окна.

        Подсветка тише прежней: заметить наведение достаточно лёгкого фона,
        а вторичное действие не должно спорить с главным.
    -->
    <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Regular}"/>
        <Setter Property="FontSize" Value="{StaticResource T.Body}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="{StaticResource R.Sm}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#141C2C"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Кнопка во всю ширину полосы — подвал с журналом.

        Заливки нет вовсе: любой фон на элементе шириной с окно читается как
        «нажали на пол-окна», а не как подсветка. Наведение показывает себя
        цветом текста и значка — этого хватает, потому что весь подвал и есть
        одна кнопка.
    -->
    <Style x:Key="GhostBar" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ссылка-действие внутри полоски: «Обновить», «Скачать», «Перечитать». -->
    <Style x:Key="LinkAction" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Semibold}"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <!-- ============ СЕГМЕНТНЫЙ ПЕРЕКЛЮЧАТЕЛЬ ============ -->
    <!-- Два взаимоисключающих режима. Системный RadioButton показал бы кружки
         в стиле Windows — в тёмном окне они выглядят вставленными из другой
         программы, а два кружка занимают больше места, чем две подписи. -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Regular}"/>
        <Setter Property="FontSize" Value="{StaticResource T.Body}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="6" Background="Transparent" Padding="0,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentDeep}"/>
                            <Setter Property="Foreground" Value="#F8FAFC"/>
                            <Setter Property="FontFamily" Value="{StaticResource F.Semibold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ МЕЛКАЯ КНОПКА-ОБВОДКА ============ -->
    <!-- «Изменить», «Обзор…», «Проверить» — действия внутри строки настроек.
         Обводка вместо заливки: заливка спорила бы с главным действием. -->
    <Style x:Key="Outline" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Regular}"/>
        <Setter Property="FontSize" Value="{StaticResource T.Label}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="7" BorderThickness="1"
                            BorderBrush="{StaticResource Line}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <!-- Выравнивание берётся у кнопки, а не прибито к центру.
                             Прибитый центр сжимал содержимое по ширине текста, и
                             в строке «подпись слева · код справа» оба съезжались
                             в одну точку и печатались друг поверх друга. -->
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentDeep}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ПОЛОСА ПРОКРУТКИ ============ -->
    <!--
        По образцу Telegram: тонкая капля без дорожки, без стрелок и без фона.
        Три вещи делают её незаметной:

        1. НАКЛАДНАЯ. Ширина полосы 0, ползунок вынесен наружу отрицательным
           отступом. Полоса не отнимает место у содержимого и не ложится на
           него — раньше она сидела прямо поверх выпадающих списков.
        2. ТОНКАЯ И ПОЛУПРОЗРАЧНАЯ. 3 px в покое; цвет не сплошной, поэтому
           она не спорит с текстом.
        3. РАСТЁТ ПОД КУРСОРОМ. Наведение — 6 px и заметнее: попасть по 3 px
           мышью нельзя, а искать её глазами не нужно.

        Дорожки нет намеренно: сплошная колея вдоль всей высоты в маленьком
        окне читается как граница панели.
    -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="track" Background="Transparent" Width="10">
                        <!--
                            Радиус ЯВНЫЙ, а не R.Pill (999).

                            У узкого и высокого прямоугольника WPF скругляет по
                            половине ВЫСОТЫ, а не ширины: 999 превращал ползунок
                            в линзу — он плавно сходил на нет к обоим концам и
                            выглядел иглой. У широких и низких элементов (кнопки)
                            та же величина даёт правильную пилюлю, поэтому R.Pill
                            там и остаётся.

                            Радиус — половина ширины, и меняется вместе с ней.
                        -->
                        <Border x:Name="pill" Width="4" CornerRadius="2"
                                HorizontalAlignment="Center"
                                Background="{StaticResource Muted}" Opacity="0.55"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="Opacity" Value="0.8"/>
                            <Setter TargetName="pill" Property="Width" Value="6"/>
                            <Setter TargetName="pill" Property="CornerRadius" Value="3"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="pill" Property="Opacity" Value="0.95"/>
                            <Setter TargetName="pill" Property="Width" Value="6"/>
                            <Setter TargetName="pill" Property="CornerRadius" Value="3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Margin" Value="0,2,1,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <!-- Ширина 0 у самой полосы, ползунок вынесен наружу:
                         содержимое не сжимается под неё и не прыгает, когда
                         полоса появляется и исчезает. -->
                    <Grid Width="0" HorizontalAlignment="Right">
                        <Track x:Name="PART_Track" IsDirectionReversed="True"
                               Width="10" Margin="-10,0,0,0">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ЗАТУХАНИЕ У КРАЯ ПРОКРУТКИ ============ -->
    <!--
        Строка, попавшая на нижнюю границу области прокрутки, обрывается ровно
        по ней и читается как сломанная вёрстка, а не как «ниже есть ещё».
        Особенно заметно, когда сразу под областью стоит кнопка: обрез сливается
        с её краем.

        Сделано НАКЛАДКОЙ поверх, а не OpacityMask на ScrollViewer. Маска гасит
        всё содержимое элемента вместе с полосой прокрутки: ползунок растворялся
        снизу и превращался в клин. Накладка кладётся под ползунок и его не
        трогает.

        Цвет совпадает с фоном под областью, поэтому кистей три: сцена лежит
        на фоне окна, блок полей — на панели, шторка журнала — на поверхности.

        Накладка НЕ доходит до правого края на ширину колеи ползунка. Иначе
        гасит и его: ползунок таял снизу и превращался в иглу.
    -->
    <LinearGradientBrush x:Key="FadeToBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0004070F" Offset="0"/>
        <GradientStop Color="#FF04070F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FadeToPanel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000B1220" Offset="0"/>
        <GradientStop Color="#FF0B1220" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FadeToSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00080E1B" Offset="0"/>
        <GradientStop Color="#FF080E1B" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============ ВЫПАДАЮЩИЙ СПИСОК ============ -->
    <!-- Системный ComboBox рисуется светлым и в тёмном окне выглядит дырой.
         Шаблон целиком: иначе часть остаётся системной и разъезжается. -->
    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Regular}"/>
        <Setter Property="FontSize" Value="{StaticResource T.Value}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource R.Sm}" Margin="3,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Input}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentDeep}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Combo" TargetType="ComboBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Input}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Regular}"/>
        <Setter Property="FontSize" Value="{StaticResource T.Value}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="tb" CornerRadius="{StaticResource R.Sm}"
                                            Background="{StaticResource Input}"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1.2">
                                        <Path x:Name="chev" Style="{StaticResource IconPlain}"
                                              Data="{StaticResource I.ChevronDown}"
                                              Stroke="{StaticResource Dim}" Width="14" Height="14"
                                              Stretch="Uniform" StrokeThickness="2.6"
                                              HorizontalAlignment="Right" Margin="0,0,9,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource AccentDeep}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False" Margin="10,0,28,0"
                                          VerticalAlignment="Center"/>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1.2" CornerRadius="{StaticResource R.Sm}"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200" Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
