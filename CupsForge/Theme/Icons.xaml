<!--
    Иконки — один штриховой набор в стиле Lucide (MIT), 24×24, толщина 1.7.

    Почему геометрия, а не шрифт и не картинки:
      - эмодзи (⚙ ✎ 📄, как было раньше) рисуются шрифтом системы и выглядят
        по-разному на разных машинах, а на части — цветными;
      - PNG нужен в трёх плотностях и не красится под цвет текста.
    Path красится Stroke и масштабируется без потерь.

    Один стиль штриха на весь набор: скруглённые концы и стыки. Разнобой здесь
    заметен сразу — набор перестаёт читаться как набор.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Базовый штрих. Цвет наследуется от текста рядом: иконка — часть строки,
         а не отдельная сущность со своим цветом. -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="{StaticResource Size.Stroke}"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Width" Value="{StaticResource Size.Icon}"/>
        <Setter Property="Height" Value="{StaticResource Size.Icon}"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Тот же штрих, но цвет задаётся явно: для иконок вне кнопок. -->
    <Style x:Key="IconPlain" TargetType="Path">
        <Setter Property="StrokeThickness" Value="{StaticResource Size.Stroke}"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Width" Value="{StaticResource Size.Icon}"/>
        <Setter Property="Height" Value="{StaticResource Size.Icon}"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ============ ГЕОМЕТРИЯ ============ -->
    <!--
        НЕ ПРАВЬТЕ РУКАМИ. Источник — файлы Icons\*.svg в корне репозитория:
        их можно открыть в Illustrator, Figma или Inkscape и перерисовать.
        После правки запустите sync-icons.cmd — блок ниже пересоберётся.

        Почему так, а не чтение SVG на лету: WPF не умеет SVG, а тянуть
        библиотеку ради двух десятков значков дорого — она весит больше самих
        значков и разбирает их при каждом запуске. SVG остаются источником,
        в программу едет уже разобранная геометрия.

        Самопроверка сверяет одно с другим: забытый sync-icons.cmd краснеет
        и называет разошедшиеся значки. Молчаливого расхождения быть не может.

        Координаты в поле 24x24. Меняя размер отображения, ставьте Stretch
        Uniform — но помните, что при нём масштабируется и толщина штриха.
    -->
